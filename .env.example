# Copy to .env.local for local dev, or set these in your host (e.g. Vercel)
# Project Settings -> Environment Variables. All must be prefixed VITE_ so Vite
# exposes them to the client bundle.

# Make.com webhook that receives completed quote submissions (optional override).
# VITE_QUOTE_ENDPOINT=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Ads conversion tracking ---
# From Google Ads -> Goals -> Conversions -> your "Lead" action -> tag setup.
# The tag id "AW-1234567890" and the conversion label "AbC-D_efGh12_3jk" appear
# in the event snippet as send_to: "AW-1234567890/AbC-D_efGh12_3jk".
VITE_GADS_CONVERSION_ID=AW-XXXXXXXXXX
VITE_GADS_CONVERSION_LABEL=XXXXXXXXXXXXXXXXX

# Optional: per-lead value (USD) for value-based bidding. Leave blank to send
# conversions with no value.
# VITE_GADS_CONVERSION_VALUE=35
